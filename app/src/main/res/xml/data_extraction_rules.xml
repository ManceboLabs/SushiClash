<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup and device-to-device transfer rules (API 31+).
  Only explicitly included paths are backed up or transferred.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="datastore/sushi_counter_preferences.preferences_pb" />
        <include
            domain="sharedpref"
            path="androidx.appcompat.app.AppCompatDelegate.application_locales" />
    </cloud-backup>

    <device-transfer>
        <include
            domain="file"
            path="datastore/sushi_counter_preferences.preferences_pb" />
        <include
            domain="sharedpref"
            path="androidx.appcompat.app.AppCompatDelegate.application_locales" />
    </device-transfer>
</data-extraction-rules>
