<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy auto-backup rules (API 23–30). API 31+ uses data_extraction_rules.xml.
  Only explicitly included paths are backed up.
-->
<full-backup-content>
    <!-- User preferences, history, achievements and frequent players -->
    <include
        domain="file"
        path="datastore/sushi_counter_preferences.preferences_pb" />

    <!-- App language override (AppCompat per-app locales) -->
    <include
        domain="sharedpref"
        path="androidx.appcompat.app.AppCompatDelegate.application_locales" />
</full-backup-content>
