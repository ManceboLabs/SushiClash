# Copy this file to keystore.properties (gitignored) and fill in your local values.
# Prefer an absolute path, or a path relative to the project root.
#
# Example local layout:
#   keystore/sushiclash-upload.jks   (gitignored directory)
#   keystore.properties            (gitignored)
#
# CI can inject the same values through environment variables instead:
#   RELEASE_STORE_FILE
#   RELEASE_STORE_PASSWORD
#   RELEASE_KEY_ALIAS
#   RELEASE_KEY_PASSWORD

storeFile=keystore/sushiclash-upload.jks
storePassword=
keyAlias=sushiclash-upload
keyPassword=
